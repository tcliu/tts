# Environment knobs. This file is documentation only and is never loaded;
# copy it to `.env` (git-ignored) to override locally — Vite loads `.env`
# automatically during `npm run dev`.
#
# For production, create `.env.vercel` (git-ignored) holding the values to
# push via `npm run env:sync:vercel`. It is also where the deploy script
# reads APP_BASE_URL from.

# Public URL the app is reachable at. deploy.mjs points the Vercel project's
# production domain at its hostname after each deploy; set it in `.env.vercel`.
# APP_BASE_URL=https://<your-alias>.vercel.app

# Synthesis cache directory. Defaults to `.tts` under the project root;
# on Vercel the serverless function uses `/tmp/.tts` automatically, so leave
# this unset in `.env.vercel` unless you deliberately want another path.
# TTS_CACHE_DIR=.tts

# Admin credentials. Set a scrypt hash (`ADMIN_PASSWORD_HASH`) or a plain
# password (`ADMIN_PASSWORD`, hashed in memory) to enable admin sign-in.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=
# SESSION_SECRET=change-me-in-production

# Profile selects the database backend.
# dev  - local SQLite (auto-created, schema auto-applied on boot).
# prod - Neon Postgres via DATABASE_URL (schema applied explicitly with
#        `PROFILE=prod npm run schema:apply`; boot never runs DDL).
PROFILE=dev

# Local SQLite database file (dev profile). Default: .data/tts-dev.sqlite
# (dev on Vercel uses /tmp/tts.sqlite, which is ephemeral).
# SQLITE_PATH=.data/tts-dev.sqlite

# Neon Postgres connection string. Required only for PROFILE=prod.
#DATABASE_URL=postgres://user:password@host/neondb

# Optional Postgres schema name for table isolation (prod). Empty uses public.
#SCHEMA_NAME=

# Application properties. Each has a compiled default and can be managed at
# runtime from `/admin` > Properties (file store at `TTS_PROPERTIES_FILE`,
# else `.data/admin-properties.json`; `/tmp` variant on Vercel). Env values
# override defaults and are read-only in the admin UI until cleared from the
# environment.
# TTS_RATE_LIMIT_MAX=60
# TTS_MAX_TEXT_LENGTH=2000
# TTS_CACHE_TTL_MS=604800000
# TTS_CACHE_MAX_ENTRIES=500
# TTS_CACHE_MAX_BYTES=209715200
# EDGE_TTS_TIMEOUT_MS=30000
# AUTH_PASSWORD_MIN_LENGTH=8
# TTS_PROPERTIES_FILE=.data/admin-properties.json
