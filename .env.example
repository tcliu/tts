# Environment knobs. This file is documentation only and is never loaded;
# copy it to `.env` (git-ignored) to override locally — Vite loads `.env`
# automatically during `npm run dev`.
#
# For production, create `.env.vercel` (git-ignored) holding the values to
# push via `npm run env:sync:vercel`. It is also where the deploy script
# reads APP_BASE_URL from.

# Public URL the app is reachable at. deploy.sh points the Vercel project's
# production domain at its hostname after each deploy; set it in `.env.vercel`.
# APP_BASE_URL=https://<your-alias>.vercel.app

# Synthesis cache directory. Defaults to `.tts` under the project root;
# on Vercel the serverless function uses `/tmp/.tts` automatically, so leave
# this unset in `.env.vercel` unless you deliberately want another path.
# TTS_CACHE_DIR=.tts
